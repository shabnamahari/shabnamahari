# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
#
# Nothing in the site reads these yet — the site is fully static. They are here
# as the agreed slots for the chatbot and admin panel work.

# --- Database (admin panel + chat history) ---
DATABASE_URL=

# --- Auth (protects /admin) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Chatbot ---
ANTHROPIC_API_KEY=

# --- Public site config ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
