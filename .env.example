# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
#
# Every key here is server-side only. Nothing in this file may ever be renamed
# to NEXT_PUBLIC_* — that prefix inlines the value into the browser bundle, and
# the service role key below would hand any visitor full read/write on the
# database. The one NEXT_PUBLIC_ entry at the bottom is a URL, not a secret.

# --- Supabase ---
# Three values, not one. The anon key is the public, RLS-constrained identity;
# the service role key bypasses RLS entirely and is only ever read inside a
# Route Handler. DATABASE_URL is the direct Postgres connection, used by the
# migration runner rather than by the app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Answer generation (OpenRouter) ---
# One key, one base URL, OpenAI-compatible format. Switching models is a string
# change, which is why the model itself lives in the database rather than here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Sent as HTTP-Referer and X-Title on every call so usage is attributable in the
# OpenRouter dashboard.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Sir Cue

# --- Embeddings ---
# A separate provider from OpenRouter, which serves chat models but not
# embeddings. The active model and its dimensions live in `embedding_config`;
# this is only the credential.
COHERE_API_KEY=

# --- Auth (protects /admin) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# The account that gets the `owner` role on first run.
ADMIN_OWNER_EMAIL=

# --- Sign-up (the public accounts, not the panel) ---
# Sending the one-time codes. Resend needs no verified domain to start: with
# AUTH_EMAIL_FROM unset, mail goes out as onboarding@resend.dev, which is fine
# for testing and wrong for a real code — it says nothing about who is writing.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Google sign-in. The redirect URI registered in the Google Cloud console must
# be exactly <site>/api/auth/google/callback — the app builds the same string
# from NEXT_PUBLIC_SITE_URL, and a trailing slash's difference fails the
# exchange with redirect_uri_mismatch and no hint as to which copy is wrong.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stated rather than derived, and it must match the console character for
# character. Left empty it is built from NEXT_PUBLIC_SITE_URL, which is right on
# a laptop and wrong the moment that value is copied into a deployment — Google
# sign-in would then point at a machine only the developer has, while every
# other link on the site carried on working.
#   local:      http://localhost:3000/api/auth/google/callback
#   production: https://<your domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Telegram (phase 7 only) ---
# The secret token is checked on every webhook request; a request without it is
# rejected before it reaches any handler.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Keep-alive cron ---
# Read by /api/keep-alive, which Vercel calls twice a week so Supabase never
# pauses the project for inactivity. Vercel sends it as `Authorization: Bearer
# <value>`; the route also accepts it as `?key=` so the URL can be opened by
# hand. Any long random string will do — `openssl rand -hex 32`. It is set in
# the Vercel dashboard rather than here; locally the route only needs it to
# exist, because nothing pauses a laptop.
CRON_SECRET=

# --- Public site config ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
